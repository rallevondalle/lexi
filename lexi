class Tracker:
    """Overall progress of a background download, written to JOB_STATUS for the settings page."""

    def __init__(self, names, urls):
        self.names, self.base, self.current, self.pct = names, 0, 0, -1
        self.total = sum(remote_size(u) for u in urls) or 1
        self.write(0)

    def start(self):
        self.base += self.current
        self.current = 0

    def update(self, done):
        self.current = done
        pct = min(99, (self.base + done) * 100 // self.total)
        if pct != self.pct:
            self.write(pct)

    def write(self, pct, phase="download"):
        self.pct = pct
        with open(JOB_STATUS + ".new", "w") as f:
            json.dump({"names": self.names, "pct": pct, "phase": phase}, f)
        os.replace(JOB_STATUS + ".new", JOB_STATUS)


TRACKER = None


def remote_size(url):
    try:
        req = urllib.request.Request(url, method="HEAD", headers={"User-Agent": f"lexi/{VERSION}"})
        with urllib.request.urlopen(req, timeout=20) as r:
            return int(r.headers.get("Content-Length") or 0)
    except (OSError, ValueError):
        return 0


def download(url, label):
    """Stream url, reporting progress on stderr (and to TRACKER when set)."""
    req = urllib.request.Request(url, headers={"User-Agent": f"lexi/{VERSION}"})
    resp = urllib.request.urlopen(req, timeout=60)
    total = int(resp.headers.get("Content-Length") or 0)
    if TRACKER:
        TRACKER.start()

    class Progress:
        def __init__(self):
            self.done, self.shown = 0, -1

        def read(self, n=-1):
            chunk = resp.read(n)
            self.done += len(chunk)
            if TRACKER:
                TRACKER.update(self.done)
            if total:
                pct = self.done * 100 // total
                if pct != self.shown:
                    self.shown = pct
                    print(f"\r  {label}: {pct:3d}% of {total / 1e6:.0f} MB", end="", file=sys.stderr, flush=True)
            return chunk

    return Progress()


def language_index(max_age=7 * 86400):
    """[{"name", "dir", "senses"}] for every language on kaikki.org, cached for a week."""
    try:
        if time.time() - os.path.getmtime(LANG_INDEX) < max_age:
            with open(LANG_INDEX) as f:
                return json.load(f)
    except (OSError, ValueError):
        pass
    try:
        req = urllib.request.Request(KAIKKI, headers={"User-Agent": f"lexi/{VERSION}"})
        with urllib.request.urlopen(req, timeout=20) as r:
            html = r.read().decode("utf-8", "replace")
        langs = [{"name": name, "dir": d, "senses": int(n)}
                 for d, name, n in re.findall(r'<a href="([^"/]+)/index\.html">([^<]+?) \((\d+) senses\)</a>', html)
                 if name not in ("English", "All languages combined")]
        if langs:
            os.makedirs(DATA_DIR, exist_ok=True)
            with open(LANG_INDEX, "w") as f:
                json.dump(langs, f)
            return langs
    except (OSError, ValueError):
        pass
    try:
        with open(LANG_INDEX) as f:
            return json.load(f)
    except (OSError, ValueError):
        return []


def resolve_language(name):
    """The language index entry for a name as typed ("danish", "dansk", "Norwegian Bokmål")."""
    n = name.strip().lower()
    for lang in language_index():
        if n in (lang["name"].lower(), DA_NAMES.get(lang["name"], "").lower()):
            return lang
    return None


def dump_url(lang):
    return f"{KAIKKI}{lang['dir']}/kaikki.org-dictionary-{urllib.parse.quote(lang['name'].replace(' ', ''))}.jsonl.gz"


def clean_etymology(text):
    if not text:
        return None
    lines = [l.strip() for l in text.split("\n") if l.strip()]
    if lines and lines[0] == "Etymology tree":
        # The tree lists ancestor forms and ends with "English <word>".
        end = next((i for i, l in enumerate(lines) if l.startswith("English ")), 0)
        lines = lines[end + 1:]
    # The first paragraph is the derivation itself; the rest is usually cognates.
    return lines[0][:500] if lines else None


def parse_senses(e):
    """A Wiktextract entry's senses as [depth, gloss, example] lists."""
    senses, last_parent = [], None
    for s in e.get("senses", []):
        if "no-gloss" in (s.get("tags") or []):
            continue
        glosses = s.get("raw_glosses") or s.get("glosses")
        if not glosses:
            continue
        if len(glosses) > 1 and glosses[0] != last_parent:
            senses.append([0, glosses[0], None])
        last_parent = glosses[0]
        example = next(
            (x["text"] for x in s.get("examples", []) if x.get("text") and len(x["text"]) <= 220), None
        )
        senses.append([min(len(glosses) - 1, 1), glosses[-1], example])
    return senses


def parse_ipa(e):
    ipa = []
    for snd in e.get("sounds", []):
        if snd.get("ipa") and snd["ipa"] not in ipa:
            ipa.append(snd["ipa"])
        if len(ipa) == 2:
            break
    return " ".join(ipa) or None


GENDERS = (("masculine", "m"), ("feminine", "f"), ("neuter", "n"), ("common-gender", "c"))


def with_gender(word, tags, code):
    """A noun with its gender: "en hund" in Danish, "Hund m" in other languages."""
    tags = tags or []
    if code == "da":
        if "common-gender" in tags and "neuter" not in tags:
            return "en " + word
        if "neuter" in tags and "common-gender" not in tags:
            return "et " + word
        return word
    genders = [g for tag, g in GENDERS if tag in tags]
    return word + (" " + "/".join(genders) if genders else "")


def translations(e, codes):
    """The translations in an English entry into each language in codes, as senses grouped by meaning."""
    groups = {}
    for t in e.get("translations", []) + [t for s in e.get("senses", []) for t in s.get("translations", [])]:
        code = t.get("lang_code")
        if code not in codes or not t.get("word"):
            continue
        words = groups.setdefault(code, {}).setdefault((t.get("sense") or "").strip(), [])
        word = with_gender(t["word"], t.get("tags"), code) + (f" ({t['roman']})" if t.get("roman") else "")
        if word not in words and len(words) < 8:
            words.append(word)
    return {code: [[0, (f"({sense}) " if sense else "") + ", ".join(words), None] for sense, words in g.items()]
            for code, g in groups.items()}


def english_rows(stream, main, langs):
    """(target, row) for the English dump: target None for the main database, else a language code.

    Words without a translation table get the words whose English gloss is this word (lang["inverse"]).
    """
    codes = {lang["code"] for lang in langs}
    for line in gzip.open(stream, "rt", encoding="utf-8"):
        e = json.loads(line)
        if e.get("lang_code") != "en" or not e.get("word"):
            continue
        key, pos = e["word"].lower(), e.get("pos")
        if langs:
            trans = translations(e, codes)
            for lang in langs:
                senses = trans.get(lang["code"])
                if not senses and e["word"] == key and (key, pos) in lang["inverse"]:
                    senses = [[0, ", ".join(lang["inverse"][(key, pos)]), None]]
                if senses:
                    yield lang["code"], (key, e["word"], EN_X, pos, None, None,
                                         json.dumps(senses, ensure_ascii=False), None)
        if main:
            senses = parse_senses(e)
            if senses:
                yield None, (key, e["word"], WIKT, pos, parse_ipa(e), clean_etymology(e.get("etymology_text")),
                             json.dumps(senses, ensure_ascii=False), None)


def head_forms(e, code):
    """The headword line, e.g. "en hund (singular definite hunden, plural indefinite hunde)"."""
    head = next((h.get("expansion") for h in e.get("head_templates", []) if h.get("expansion")), "")
    word = e["word"]
    if not head.startswith(word):
        return None
    if code == "da":
        m = re.match(r"^ ([cn])\b\s*(.+)$", head[len(word):])
        if m:
            head = ("en " if m.group(1) == "c" else "et ") + word + " " + m.group(2)
        return head if head.startswith(("en ", "et ")) or "(" in head else None
    return head if "(" in head or len(head) > len(word) + 2 else None


def foreign_rows(stream, lang):
    """A language's entries with English glosses; sets lang["code"] and fills lang["inverse"]."""
    inverse = lang["inverse"]
    for line in gzip.open(stream, "rt", encoding="utf-8"):
        e = json.loads(line)
        if not e.get("word") or not e.get("lang_code"):
            continue
        lang["code"] = lang["code"] or e["lang_code"]
        if e["lang_code"] != lang["code"]:
            continue
        senses = parse_senses(e)
        if not senses:
            continue
        key = e["word"].lower()
        roman = next((f["form"] for f in e.get("forms", []) if "romanization" in (f.get("tags") or [])), None)
        if roman:
            for alias in {roman.lower(), fold(roman)} - {key}:
                lang["aliases"].add((alias, key))
        pos = e.get("pos")
        for s in e.get("senses", []):
            tags = s.get("tags") or []
            if "form-of" in tags or not s.get("glosses"):
                continue
            gloss = re.sub(r"\([^)]*\)", "", s["glosses"][-1])
            for part in re.split(r"[,;]", gloss):
                part = part.strip().lower()
                if pos == "verb" and part.startswith("to "):
                    part = part[3:]
                if part and len(part.split()) <= 2:
                    words = inverse.setdefault((part, pos), [])
                    word = with_gender(e["word"], tags, lang["code"]) if pos == "noun" else e["word"]
                    if word not in words and len(words) < 8:
                        words.append(word)
        yield (e["word"].lower(), e["word"], FOREIGN, pos, parse_ipa(e), clean_etymology(e.get("etymology_text")),
               json.dumps(senses, ensure_ascii=False), head_forms(e, lang["code"]))


WN_POS = {"n": "noun", "v": "verb", "a": "adj", "s": "adj", "r": "adv"}


def wordnet_rows(stream, source=WORDNET):
    synsets, entries = {}, []
    for _, el in ET.iterparse(gzip.open(stream)):
        if el.tag == "LexicalEntry":
            lemma = el.find("Lemma")
            entries.append((lemma.get("writtenForm"), lemma.get("partOfSpeech"),
                            [s.get("synset") for s in el.findall("Sense")]))
            el.clear()
        elif el.tag == "Synset":
            d = el.find("Definition")
            synsets[el.get("id")] = {
                "def": d.text if d is not None else None,
                "ex": [x.text for x in el.findall("Example") if x.text][:1],
                "lemmas": [],
            }
            el.clear()
    for word, _, ids in entries:
        for sid in ids:
            if sid in synsets:
                synsets[sid]["lemmas"].append(word)
    for word, pos, ids in entries:
        senses = []
        for sid in ids:
            s = synsets.get(sid)
            if not s or not s["def"]:
                continue
            syn = [l for l in s["lemmas"] if l != word][:6]
            gloss = s["def"] + (f"  [syn: {', '.join(syn)}]" if syn else "")
            senses.append([0, gloss, s["ex"][0] if s["ex"] else None])
        if senses:
            yield (word.lower(), word, source, WN_POS.get(pos, pos), None, None,
                   json.dumps(senses, ensure_ascii=False), None)


def wordnet_url():
    try:
        with urllib.request.urlopen(WORDNET_RELEASES, timeout=20) as r:
            assets = json.load(r).get("assets", [])
        for a in assets:
            if re.fullmatch(r"english-wordnet-\d{4}\.xml\.gz", a["name"]):
                return a["browser_download_url"]
    except (OSError, ValueError, KeyError):
        pass
    return WORDNET_FALLBACK


# Part-of-speech headings in the Danish Wiktionary, e.g. {{-noun-|da}}.
DA_POS = {"noun": "noun", "verb": "verb", "adj": "adj", "adv": "adv", "prop": "name", "interj": "intj",
          "abr": "abbrev", "phr": "phrase", "expr": "phrase", "pp": "pron", "pron": "pron", "end": "suffix",
          "suf": "suffix", "prep": "prep", "pref": "prefix", "prov": "proverb", "conj": "conj", "num": "num",
          "art": "article", "particle": "particle"}


def wiki_template(m):
    """{{term|x}} and {{l|da|x}} become x; other templates (labels, genders, boxes) are dropped."""
    parts = m.group(1).split("|")
    name, args = parts[0].strip(), [p for p in parts[1:] if "=" not in p]
    if name in ("term", "w", "ordet") and args:
        return args[0]
    if name in ("l", "m", "link") and len(args) > 1:
        return args[1]
    return ""


def wikiclean(text):
    """Wikitext as plain text: links, templates, bold and italics, references."""
    text = re.sub(r"<ref[^>]*/>|<ref.*?</ref>", "", text, flags=re.S)
    text = re.sub(r"<[^>]+>", "", text)
    for _ in range(3):  # templates inside templates
        text = re.sub(r"\{\{([^{}]*)\}\}", wiki_template, text)
    text = re.sub(r"\[\[(?:Fil|File|Billede|Image|Kategori|Category):[^\]]*\]\]", "", text)
    text = re.sub(r"\[\[[^\]|]*\|([^\]]*)\]\]", r"\1", text)
    text = re.sub(r"\[\[([^\]]*)\]\]", r"\1", text)
    text = re.sub(r"'{2,}", "", text)
    text = re.sub(r"\(\s*([^()]*?)\s*\)\s*:", r"(\1)", text)  # "(zoologi):" → "(zoologi)"
    return re.sub(r"\s+", " ", text).strip()


def da_wiktionary_rows(stream):
    """Danish words with Danish definitions and examples, from the Danish Wiktionary's dump."""
    for _, el in ET.iterparse(bz2.open(stream)):
        if not el.tag.endswith("}page"):
            continue
        title = ns = text = None
        for c in el.iter():
            tag = c.tag.rsplit("}", 1)[-1]
            if tag == "title":
                title = c.text
            elif tag == "ns":
                ns = c.text
            elif tag == "text":
                text = c.text or ""
        el.clear()
        if ns != "0" or not title or not text or "{{=da=}}" not in text:
            continue
        section = re.split(r"\{\{=[\w-]+=\}\}", text.split("{{=da=}}", 1)[1])[0]
        entries, senses = [], None
        for line in section.splitlines():
            line = line.strip()
            m = re.match(r"^=*\s*\{\{-([\w-]+)-(?:\|([^}|]*))?[^}]*\}\}", line)
            if m:
                # Pages sometimes add other languages without a {{=xx=}} heading: {{-noun-|sv}}.
                pos = DA_POS.get(m.group(1)) if m.group(2) in (None, "", "da") else None
                senses = [] if pos else None
                if pos:
                    entries.append((pos, senses))
                continue
            if senses is None:
                continue
            if re.match(r"^##[^:*#]", line):
                senses.append([1, wikiclean(line[2:]), None])
            elif re.match(r"^#[^:*#]", line):
                senses.append([0, wikiclean(line[1:]), None])
            elif re.match(r"^#+[:*]", line) and senses and senses[-1][2] is None:
                example = wikiclean(re.sub(r"^#+[:*]+", "", line))
                if example and len(example) <= 220:
                    senses[-1][2] = example
        for pos, senses in entries:
            senses = [s for s in senses if s[1]]
            if senses:
                yield (title.lower(), title, NATIVE, pos, None, None, json.dumps(senses, ensure_ascii=False), None)


def dannet_url():
    try:
        with urllib.request.urlopen(DANNET_RELEASES, timeout=20) as r:
            for a in json.load(r).get("assets", []):
                if a["name"] == "dannet-wn-lmf.xml.gz":
                    return a["browser_download_url"]
    except (OSError, ValueError, KeyError):
        pass
    return DANNET_FALLBACK


def extras(name):
    """Definitions in the language itself, for languages that have an open source of them."""
    if name == "Danish":
        return [("Wiktionary (dansk)", DAWIKT_URL, da_wiktionary_rows),
                ("DanNet", dannet_url(), lambda stream: wordnet_rows(stream, DANNET))]
    return []


def new_db(path):
    if os.path.exists(path):
        os.remove(path)
    db = sqlite3.connect(path)
    db.executescript("""
        PRAGMA journal_mode = OFF;
        PRAGMA synchronous = OFF;
        CREATE TABLE entries (key TEXT, word TEXT, source INT, pos TEXT, ipa TEXT, etym TEXT, senses TEXT,
                              forms TEXT);
        CREATE TABLE meta (key TEXT PRIMARY KEY, value TEXT);
        CREATE TABLE aliases (key TEXT, target TEXT);
    """)
    return db


def finish_db(db, tmp, path, meta):
    db.executemany("INSERT INTO meta VALUES (?, ?)", meta.items())
    db.executescript("""
        CREATE INDEX entries_key ON entries (key);
        CREATE INDEX aliases_key ON aliases (key);
        CREATE TABLE words AS SELECT key FROM entries UNION SELECT key FROM aliases;
        CREATE INDEX words_key ON words (key);
        VACUUM;
    """)
    db.close()
    os.replace(tmp, path)
    print(f"  {meta.get('name', 'English')}: {path} ({os.path.getsize(path) / 1e6:.0f} MB)", file=sys.stderr)


class Inserter:
    def __init__(self, db):
        self.db, self.batch, self.n = db, [], 0

    def add(self, row):
        self.batch.append(row)
        self.n += 1
        if len(self.batch) == 20000:
            self.flush()

    def flush(self):
        self.db.executemany("INSERT INTO entries VALUES (?,?,?,?,?,?,?,?)", self.batch)
        self.batch.clear()


def build(english, languages):
    """Rebuild the English database (if english) and the given languages from kaikki.org's index.

    The translations into a language live in the English dump, so every build streams it once.
    """
    os.makedirs(LANG_DIR, exist_ok=True)
    langs = []
    for info in languages:
        tmp = os.path.join(LANG_DIR, re.sub(r"\W+", "_", info["name"]) + ".db.new")
        lang = {"name": info["name"], "code": None, "tmp": tmp, "db": new_db(tmp), "inverse": {}, "aliases": set()}
        ins = Inserter(lang["db"])
        for row in foreign_rows(download(dump_url(info), info["name"]), lang):
            ins.add(row)
        ins.flush()
        lang["db"].executemany("INSERT INTO aliases VALUES (?, ?)", sorted(lang["aliases"]))
        for label, url, parse in extras(info["name"]):
            for row in parse(download(url, label)):
                ins.add(row)
            ins.flush()
        print(f"\r  {info['name']}: {ins.n:,} entries" + " " * 20, file=sys.stderr)
        if lang["code"]:
            langs.append(lang)
        else:
            lang["db"].close()
            os.remove(tmp)
    main = None
    if english:
        main = {"tmp": DB + ".new"}
        main["db"] = new_db(main["tmp"])
        ins = Inserter(main["db"])
        for row in wordnet_rows(download(wordnet_url(), "Open English WordNet")):
            ins.add(row)
        ins.flush()
        print(f"\r  Open English WordNet: {ins.n:,} entries" + " " * 20, file=sys.stderr)
    if main or langs:
        targets = {None: Inserter(main["db"])} if main else {}
        targets.update({lang["code"]: Inserter(lang["db"]) for lang in langs})
        for target, row in english_rows(download(WIKTIONARY_URL, "Wiktionary (English)"), bool(main), langs):
            targets[target].add(row)
        for ins in targets.values():
            ins.flush()
        print(f"\r  Wiktionary (English): done" + " " * 30, file=sys.stderr)
    print("  Indexing…", file=sys.stderr)
    if TRACKER:
        TRACKER.write(100, "indexing")
    for lang in langs:
        finish_db(lang["db"], lang["tmp"], os.path.join(LANG_DIR, lang["code"] + ".db"),
                  {"code": lang["code"], "name": lang["name"]})
    if main:
        finish_db(main["db"], main["tmp"], DB, {})


def resolve_all(names):
    found = []
    for name in names:
        lang = resolve_language(name)
        if not lang:
            sys.exit(f"lexi: no language called '{name}' on kaikki.org (see lexi languages --all)")
        found.append(lang)
    return found


def update(names=()):
    installed = [l["name"] for l in installed_languages()]
    languages = resolve_all(list(dict.fromkeys(installed + list(names))))
    extra = " and " + ", ".join(l["name"] for l in languages) if languages else ""
    print(f"Building the lexi dictionary (English{extra}). This downloads about 550 MB "
          "and takes a few minutes.", file=sys.stderr)
    build(True, languages)
    print("Done.", file=sys.stderr)


def add(names):
    """Download languages (what the settings run in the background); notifies the desktop when done."""
    languages = resolve_all(names)
    label = ", ".join(l["name"] for l in languages)
    os.makedirs(STATE_DIR, exist_ok=True)
    if not job_running():
        with open(JOB_PID, "w") as f:
            f.write(str(os.getpid()))
    print(f"{T['downloading']} {label}…", file=sys.stderr)
    global TRACKER
    try:
        urls = [u for l in languages for u in [dump_url(l)] + [url for _, url, _ in extras(l["name"])]]
        TRACKER = Tracker([l["name"] for l in languages], urls + [WIKTIONARY_URL])
        build(False, languages)
        message = T["add_done"].format(label)
    except Exception as e:
        print(f"\nlexi: {e}", file=sys.stderr)
        message = T["add_failed"].format(label, JOB_LOG)
        raise
    finally:
        print(f"\n{message}", file=sys.stderr)
        if shutil.which("notify-send") and not sys.stderr.isatty():
            subprocess.run(["notify-send", "lexi", message])
        for path in (JOB_PID, JOB_STATUS):
            try:
                os.remove(path)
            except OSError:
                pass


def remove_language(name):
    n = name.strip().lower()
    for lang in installed_languages():
        if n in (lang["name"].lower(), lang["code"].lower(), DA_NAMES.get(lang["name"], "").lower()):
            os.remove(lang["path"])
            return lang["name"]
    return None


# ---------- main ----------

def main():
    args = sys.argv[1:]
    if not args:
        launch()
    elif args[0] in ("-h", "--help"):
        print(__doc__.strip())
    elif args[0] in ("-V", "--version"):
        print(f"lexi {VERSION}")
    elif args[0] == "update":
        try:
            update(args[1:])
        except KeyboardInterrupt:
            sys.exit("\nlexi: update cancelled")
    elif args[0] == "add":
        if not args[1:]:
            sys.exit("usage: lexi add LANGUAGE... (see lexi languages --all)")
        try:
            add(args[1:])
        except KeyboardInterrupt:
            sys.exit("\nlexi: cancelled")
    elif args[0] == "remove":
        for name in args[1:]:
            removed = remove_language(name)
            print(f"Removed {removed}." if removed else f"lexi: {name} isn't installed")
    elif args[0] == "languages":
        if args[1:] == ["--all"]:
            for lang in language_index():
                print(f"{lang['name']}  ({lang['senses']:,} senses)")
        else:
            for lang in installed_languages():
                print(f"{lang['name']} ({lang['code']})")
    elif args[0] == "settings":
        launch(settings=True)
    elif args[0] == "--json":
        print(json.dumps(collect(" ".join(args[1:])), ensure_ascii=False))
    elif args[0] == "--complete":
        print(json.dumps(complete(" ".join(args[1:])), ensure_ascii=False))
    elif args[0] == "--open":
        launch(" ".join(args[1:]) or None)
    elif args[0] == "--view":
        if args[1:] == ["--settings"]:
            Popup(None, settings=True).run()
        else:
            Popup(" ".join(args[1:]) or None).run()
    else:
        width = min(TEXT_WIDTH, shutil.get_terminal_size().columns - 2)
        lines, found = render(" ".join(args), width)
        if not sys.stdout.isatty():
            lines = [plain(l) for l in lines]
        print("\n".join(lines))
        sys.exit(0 if found else 1)


if __name__ == "__main__":
    main()
