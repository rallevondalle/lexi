def load_config():
    """~/.config/lexi/config holds key = value lines; LEXI_* environment variables win."""
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_FILE) as f:
            for line in f:
                line = line.split("#", 1)[0]
                if "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip().strip('"')
    except OSError:
        pass
    for k in list(cfg):
        cfg[k] = os.environ.get("LEXI_" + k.upper(), cfg[k])
    return cfg


def save_config(key, value):
    """Set one key in the config file, keeping the other lines and comments."""
    CFG[key] = str(value)
    try:
        with open(CONFIG_FILE) as f:
            lines = f.read().splitlines()
    except OSError:
        lines = []
    line = f"{key} = {value}"
    for i, l in enumerate(lines):
        if re.match(rf"^\s*{key}\s*=", l):
            lines[i] = line
            break
    else:
        lines.append(line)
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        f.write("\n".join(lines) + "\n")


