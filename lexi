def on_hyprland():
    return bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")) and shutil.which("hyprctl")


def hyprctl(*args):
    try:
        return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout
    except OSError:
        return ""


def hypr_client():
    try:
        clients = json.loads(hyprctl("clients", "-j"))
    except json.JSONDecodeError:
        return None
    ours = [c for c in clients if c.get("class") == APP_ID]
    for c in ours:
        if c.get("pid") == os.getppid():
            return c
    return ours[-1] if ours else None


def hypr_dispatch(lua, legacy):
    """Lua-configured Hyprland takes Lua dispatchers; older versions take the classic syntax."""
    r = hyprctl("dispatch", lua)
    if "error" in r.lower() or "invalid" in r.lower():
        hyprctl("dispatch", *legacy.split(" ", 1))


def max_rows(cell_h):
    try:
        mon = next(m for m in json.loads(hyprctl("monitors", "-j")) if m.get("focused"))
        logical_h = mon["height"] / mon["scale"]
    except (StopIteration, json.JSONDecodeError, KeyError):
        logical_h = 800
    return max(8, int(logical_h * 0.85 / cell_h))


def target_grid(nlines, cell_h=24):
    cols = TEXT_WIDTH + 2 * MARGIN
    rows = min(nlines + 3, max_rows(cell_h))  # a blank row above and below, plus the status line
    return cols, max(rows, 8)


def read_fit():
    try:
        with open(FIT_FILE) as f:
            return tuple(map(float, f.read().split()))
    except (OSError, ValueError):
        return None


def write_fit(cw, ch, base_w, base_h):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(FIT_FILE, "w") as f:
        f.write(f"{cw:.3f} {ch:.3f} {base_w:.1f} {base_h:.1f}\n")


def presize(nlines):
    """Install a window rule before the terminal starts so the window maps floating, centered and sized."""
    if not on_hyprland():
        return
    props = "float = true, center = true, opacity = \"1 1\""
    fit = read_fit()
    if fit and len(fit) == 4:
        cw, ch, base_w, base_h = fit
        cols, rows = target_grid(nlines, ch)
        props += f", size = {{ {round(base_w + cols * cw)}, {round(base_h + (rows + 0.5) * ch)} }}"
    else:
        props += ", size = { 820, 560 }"
    hyprctl("eval", "if lexi_rule then lexi_rule:set_enabled(false) end; "
            f'lexi_rule = hl.window_rule({{ match = {{ class = "{APP_ID}" }}, {props} }})')


def settle():
    prev, held = None, 0
    for _ in range(20):
        cur = shutil.get_terminal_size()
        held = held + 1 if cur == prev else 0
        if held == 2:
            return
        prev = cur
        time.sleep(0.05)


def fit_window(nlines):
    """Resize the popup to its content and remember the cell size for next time."""
    if not on_hyprland():
        return
    settle()
    c = hypr_client()
    if c and not c.get("floating"):
        # Hyprland without the Lua rule API: float it by hand.
        hypr_dispatch(f'hl.dsp.window.float({{ action = "enable", window = "address:{c["address"]}" }})',
                      f"setfloating address:{c['address']}")
        settle()
    for _ in range(3):
        c = hypr_client()
        if not c:
            return
        cols, rows = shutil.get_terminal_size()
        w, h = c["size"]
        fit = read_fit()
        cw, ch = (fit[0], fit[1]) if fit and len(fit) == 4 else (w / cols, h / rows)
        tcols, trows = target_grid(nlines, ch)
        if abs(cols - tcols) <= 1 and rows == trows:
            write_fit(cw, ch, w - cols * cw, h - rows * ch)
            return
        nw, nh = round(w + (tcols - cols) * cw), round(h + (trows - rows) * ch)
        addr = c["address"]
        hypr_dispatch(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {nw}, y = {nh} }})',
                      f"resizewindowpixel exact {nw} {nh},address:{addr}")
        hypr_dispatch(f'hl.dsp.window.center({{ window = "address:{addr}" }})', "centerwindow")
        settle()
        # Measure the cell size from the change, which cancels out the terminal padding.
        ncols, nrows = shutil.get_terminal_size()
        if ncols != cols and nrows != rows:
            cw, ch = (nw - w) / (ncols - cols), (nh - h) / (nrows - rows)
            write_fit(cw, ch, nw - ncols * cw, nh - nrows * ch)


def plain(text):
    return re.sub(r"\033\[[0-9;]*m", "", text)


KEYS = {"A": "up", "B": "down", "C": "right", "D": "left", "H": "home", "F": "end",
        "1~": "home", "7~": "home", "4~": "end", "8~": "end", "5~": "pgup", "6~": "pgdn"}
CONTROL = {"\r": "enter", "\n": "enter", "\x7f": "backspace", "\x08": "backspace", "\t": "tab",
           "\x13": "settings", "\x03": "quit", "\x11": "quit", "\x15": "clear"}


class Terminal:
    """Raw keyboard and mouse input, and full-screen output, on the controlling terminal."""

    def __enter__(self):
        import termios
        import tty
        self.fd = sys.stdin.fileno()
        self.saved = termios.tcgetattr(self.fd)
        tty.setraw(self.fd)
        self.buf = b""
        self.decoder = codecs.getincrementaldecoder("utf-8")("ignore")
        # Alternate screen, no cursor, no line wrapping, mouse clicks and wheel.
        self.write("\033[?1049h\033[?25l\033[?7l\033[?1000h\033[?1006h")
        return self

    def __exit__(self, *exc):
        import termios
        self.write("\033[?1000l\033[?1006l\033[?7h\033[?25h\033[?1049l")
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)

    def write(self, text):
        sys.stdout.write(text)
        sys.stdout.flush()

    def _more(self, timeout):
        if select.select([self.fd], [], [], timeout)[0]:
            data = os.read(self.fd, 4096)
            self.buf += data
            return bool(data)
        return False

    def key(self, timeout):
        """The next key ("up", "enter", a character, ("mouse", button, x, y)…), or None after timeout."""
        if not self.buf and not self._more(timeout):
            return None
        b = self.buf
        if b[:1] == b"\033":
            if len(b) == 1 and not self._more(0.03):
                self.buf = b""
                return "esc"
            b = self.buf
            m = re.match(rb"\033\[<(\d+);(\d+);(\d+)([Mm])", b)
            if m:
                self.buf = b[m.end():]
                return ("mouse", int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4) == b"M")
            m = re.match(rb"\033[\[O]([\d;]*)([A-Za-z~])", b)
            if m:
                self.buf = b[m.end():]
                params, final = m.group(1).decode(), m.group(2).decode()
                name = KEYS.get(final) or KEYS.get(params.split(";")[0] + final)
                if name in ("left", "right") and params.endswith((";3", ";9")):
                    name = "alt-" + name
                return name
            if len(b) > 1 and b[1:2] not in (b"[", b"O"):
                self.buf = b[2:]  # Alt+key: ignore
                return None
            if not self._more(0.05):
                self.buf = b""
            return None
        # A character, possibly several UTF-8 bytes long.
        n = 1 if b[0] < 0xC0 else 2 if b[0] < 0xE0 else 3 if b[0] < 0xF0 else 4
        if len(b) < n and not self._more(0.05):
            self.buf = b""
            return None
        ch, self.buf = self.decoder.decode(self.buf[:n]), self.buf[n:]
        if ch in CONTROL:
            return CONTROL[ch]
        return ch if ch and ch.isprintable() else None


class Popup:
    """The popup: a word's entry, a line to type the next word, and the settings."""

    def __init__(self, word, settings=False):
        self.history, self.pos = [], -1
        self.lines, self.top, self.input = [], 0, ""
        self.mode = "settings" if settings else "view"
        self.settings = Settings(self)
        self.word = None
        self.word_arg = word

    def run(self):
        with Terminal() as self.term:
            if self.word_arg:
                self.open(self.word_arg)
            else:
                fit_window(len(self.lines) or 6)
            if self.mode == "settings":
                self.settings.enter()
            size = None
            while True:
                if shutil.get_terminal_size() != size:
                    size = shutil.get_terminal_size()
                    if self.word:
                        self.lines = render(self.word, self.width())[0]
                self.draw()
                key = self.term.key(1)
                if key is None:
                    continue
                handler = self.settings.handle if self.mode == "settings" else self.handle
                if handler(key) == "quit":
                    return

    def width(self):
        return max(30, min(TEXT_WIDTH, shutil.get_terminal_size().columns - 2))

    def pad(self):
        return max(1, (shutil.get_terminal_size().columns - self.width()) // 2)

    def open(self, word, push=True):
        self.word = word
        self.lines, self.top, self.input = render(word, self.width())[0], 0, ""
        if push:
            self.history = self.history[:self.pos + 1] + [word]
            self.pos += 1
        fit_window(len(self.lines))

    def draw(self):
        cols, rows = shutil.get_terminal_size()
        lines, status = (self.settings.view(rows) if self.mode == "settings" else self.view(rows))
        out = []
        for i in range(rows - 1):
            out.append(f"\033[{i + 1};1H\033[2K" + (lines[i] if i < len(lines) else ""))
        out.append(f"\033[{rows};1H\033[2K" + status)
        self.term.write("".join(out))

    def body(self):
        return shutil.get_terminal_size().lines - 2  # a blank first row, and the status line

    def view(self, rows):
        pad = " " * self.pad()
        lines = [""] + [pad + l for l in self.lines[self.top:self.top + self.body()]]
        if self.input or not self.lines:
            hints = complete(self.input, 5) if self.input else []
            hints = [h for h in hints if h != self.input.lower()][:4]
            status = (style(T["lookup"] + ": ", DIM) + self.input + style(" ", REVERSE)
                      + style("   " + "  ".join(hints), DIM))
        else:
            more = self.top + self.body() < len(self.lines)
            status = style(T["hint"], DIM) + (style("   " + T["more"], ACCENT) if more else "")
        return lines, pad + status

    def scroll(self, n):
        self.top = max(0, min(self.top + n, len(self.lines) - self.body()))

    def handle(self, key):
        page = max(1, self.body() - 1)
        if isinstance(key, tuple):
            _, button, x, y, press = key
            if button == 64:
                self.scroll(-3)
            elif button == 65:
                self.scroll(3)
            elif button == 0 and press:
                word = self.word_at(x - 1, y - 2)
                if word:
                    self.open(word)
        elif key == "quit":
            return "quit"
        elif key == "esc":
            if not self.input:
                return "quit"
            self.input = ""
        elif key == "enter":
            if self.input.strip():
                self.open(self.input.strip())
        elif key == "backspace":
            self.input = self.input[:-1]
        elif key == "clear":
            self.input = ""
        elif key == "tab":
            hints = complete(self.input, 2) if self.input else []
            hints = [h for h in hints if h != self.input.lower()]
            if hints:
                self.input = hints[0]
        elif key == "settings":
            self.settings.enter()
        elif key in ("left", "alt-left") and not self.input and self.pos > 0:
            self.pos -= 1
            self.open(self.history[self.pos], push=False)
        elif key in ("right", "alt-right") and not self.input and self.pos < len(self.history) - 1:
            self.pos += 1
            self.open(self.history[self.pos], push=False)
        elif key == "up":
            self.scroll(-1)
        elif key == "down":
            self.scroll(1)
        elif key == "pgup":
            self.scroll(-page)
        elif key == "pgdn":
            self.scroll(page)
        elif key == "home":
            self.top = 0
        elif key == "end":
            self.scroll(len(self.lines))
        elif key == " " and not self.input:
            self.scroll(page)
        elif len(key) == 1:
            self.input += key
        return None

    def word_at(self, col, row):
        """The word shown at a screen position (0-based, relative to the text area)."""
        i = self.top + row
        if row < 0 or i >= len(self.lines):
            return None
        text, col = plain(self.lines[i]), col - self.pad()
        if not 0 <= col < len(text):
            return None
        # Letters, digits and combining marks (the vowel signs in कुत्ता), plus ' and -.
        inside = lambda c: unicodedata.category(c)[0] in "LMN" or c in "'’-"
        start = end = col
        while start > 0 and inside(text[start - 1]):
            start -= 1
        while end < len(text) and inside(text[end]):
            end += 1
        word = text[start:end].strip("'’-")
        return word if len(word) > 1 and not word.isdigit() else None


# ---------- settings ----------

def job_pid():
    """The pid of the running download, or None."""
    try:
        with open(JOB_PID) as f:
            pid = int(f.read().strip())
    except (OSError, ValueError):
        return None
    try:
        # Reap it if this popup started it and it has finished, so it doesn't linger as a zombie.
        if os.waitpid(pid, os.WNOHANG)[0] == pid:
            return None
    except ChildProcessError:
        pass
    try:
        os.kill(pid, 0)
        return pid
    except OSError:
        return None


def job_running():
    return job_pid() is not None


def stop_job():
    """Stop the running download and remove its half-built files."""
    import signal
    pid = job_pid()
    if pid:
        try:
            os.killpg(pid, signal.SIGTERM)
        except OSError:
            try:
                os.kill(pid, signal.SIGTERM)  # `lexi add` run from a shell isn't a group leader
            except OSError:
                pass
        for _ in range(20):
            if not job_running():
                break
            time.sleep(0.1)
    for path in [JOB_PID, JOB_STATUS] + glob.glob(os.path.join(LANG_DIR, "*.db.new")):
        try:
            os.remove(path)
        except OSError:
            pass


def job_progress():
    """{"names", "pct", "phase"} of the running download, or None."""
    if not job_running():
        return None
    try:
        with open(JOB_STATUS) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def job_status():
    """The download's final line once it has finished recently (its progress shows in the rows)."""
    try:
        with open(JOB_LOG, errors="replace") as f:
            text = f.read()
        recent = time.time() - os.path.getmtime(JOB_LOG) < 600
    except OSError:
        return None
    parts = [p.strip() for p in re.split(r"[\r\n]", text) if p.strip()]
    if not parts or job_running() or not recent:
        return None
    return parts[-1]


def start_job(names):
    os.makedirs(STATE_DIR, exist_ok=True)
    log = open(JOB_LOG, "w")
    proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "add", *names],
                            stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    with open(JOB_PID, "w") as f:
        f.write(str(proc.pid))


BAR = 14  # width of the progress bar behind "downloading"


def progress_bar(progress):
    """ "downloading" on a bar that fills from the left, then the percentage."""
    label = T["indexing"] if progress["phase"] == "indexing" else T["downloading_short"]
    text = f" {label}".ljust(BAR)[:BAR]
    fill = round(BAR * progress["pct"] / 100)
    return style(text[:fill], REVERSE, "\033[34m") + style(text[fill:], ACCENT) + style(f"{progress['pct']:>4}%", ACCENT)


class Settings:
    """Settings page: interface language, font size, width, WordNet and which languages are downloaded."""

    FIXED = ["lang", "font_size", "width", "wordnet"]

    def __init__(self, popup):
        self.popup = popup
        self.cursor, self.filter, self.pending, self.message = 0, "", {}, ""
        self.index, self.index_failed, self.confirm = None, False, False
        self.top = 0

    def enter(self):
        self.popup.mode = "settings"
        self.cursor, self.filter, self.message, self.confirm = 0, "", "", False
        if self.index is None:
            threading.Thread(target=self.load_index, daemon=True).start()
        fit_window(30)

    def load_index(self):
        self.index = language_index()
        self.index_failed = not self.index

    def leave(self):
        self.popup.mode = "view"
        self.pending.clear()
        if self.popup.word:
            self.popup.open(self.popup.word, push=False)
        else:
            fit_window(6)

    def items(self):
        installed = {l["name"] for l in installed_languages()}
        progress = job_progress()
        coming = [n for n in (progress or {}).get("names", []) if n not in installed]
        names = sorted(installed) + coming + [l["name"] for l in self.index or []
                                              if l["name"] not in installed and l["name"] not in coming]
        senses = {l["name"]: l["senses"] for l in self.index or []}
        if self.filter:
            f = self.filter.lower()
            names = [n for n in names if f in n.lower() or f in DA_NAMES.get(n, "").lower()]
        return [("setting", k) for k in self.FIXED] + [("lang", n, n in installed, senses.get(n)) for n in names]

    def value(self, key):
        if key == "lang":
            return INTERFACES.get(CFG["lang"], CFG["lang"])
        if key == "wordnet":
            return T["on"] if wordnet_on() else T["off"]
        return CFG[key]

    def view(self, rows):
        pad = " " * self.popup.pad()
        width = self.popup.width()
        items = self.items()
        self.cursor = min(self.cursor, len(items) - 1)
        out, cursor_line = ["", style("lexi · " + T["settings"], ACCENT), ""], 0
        progress = job_progress()
        progress_names = set(progress["names"]) if progress else set()
        for i, item in enumerate(items):
            if item[0] == "setting":
                key = item[1]
                label = T["interface"] if key == "lang" else T[key]
                text = f"{label:<24}◀ {self.value(key)} ▶"
                extra = style("   " + T["next_time"], DIM) if key == "font_size" else ""
            else:
                if i == len(self.FIXED):
                    filt = (self.filter + style(" ", REVERSE)) if self.filter else style(T["filter"], DIM)
                    out += ["", style(T["dictionaries"], LABEL) + "   " + filt, ""]
                    status = job_status()
                    if status:
                        out += [style(status, ACCENT)[:width + 20], ""]
                    out.append("   " + f"[x] {T['english']}" + style(f"   {T['always']}", DIM))
                _, name, installed, senses = item
                action = self.pending.get(name)
                checked = (installed or name in progress_names) != (action is not None)
                shown = name + (f" · {DA_NAMES[name]}" if T is STRINGS["da"] and name in DA_NAMES else "")
                text = f"[{'x' if checked else ' '}] {shown}"
                note = (T["will_add"] if action == "add" else T["will_remove"] if action == "remove"
                        else T["will_stop"] if action == "stop"
                        else T["installed"] if installed else T["senses"].format(max(1, round(senses / 1000)))
                        if senses else "")
                extra = style(" " * max(2, width - 8 - len(text) - len(note)) + note,
                              ACCENT if action else DIM)
                if name in progress_names and not action:
                    extra = " " * max(2, width - 8 - len(text) - BAR - 5) + progress_bar(progress)
            if i == self.cursor:
                cursor_line = len(out)
            out.append(("  " + style(" " + text + " ", REVERSE) if i == self.cursor else "   " + text + " ") + extra)
        if len(items) == len(self.FIXED):
            out += ["", style(T["dictionaries"], LABEL) + "   " + (self.filter + style(" ", REVERSE)
                                                              if self.filter else style(T["filter"], DIM))]
        if self.index is None:
            out += ["", style(T["loading_list"], DIM)]
        elif self.index_failed:
            out += ["", style(T["offline_list"], DIM)]
        if self.message:
            out = out[:3] + [style(m, ACCENT) for m in textwrap.wrap(self.message, width)] + [""] + out[3:]
            cursor_line += len(textwrap.wrap(self.message, width)) + 1
        body = rows - 1
        if cursor_line < self.top + 3:
            self.top = max(0, cursor_line - 3)
        elif cursor_line >= self.top + body - 2:
            self.top = cursor_line - body + 3
        return [pad + l for l in out[self.top:self.top + body]], pad + style(T["settings_keys"], DIM)

    def change(self, key, step):
        global T, TEXT_WIDTH
        if key == "lang":
            codes = list(INTERFACES)
            code = codes[(codes.index(CFG["lang"]) + step) % len(codes)] if CFG["lang"] in codes else "en"
            save_config("lang", code)
            T = STRINGS[code]
        elif key == "font_size":
            save_config("font_size", min(32, max(6, int(CFG["font_size"]) + step)))
        elif key == "width":
            TEXT_WIDTH = min(140, max(40, TEXT_WIDTH + 4 * step))
            save_config("width", TEXT_WIDTH)
            fit_window(30)
        elif key == "wordnet":
            save_config("wordnet", "off" if wordnet_on() else "on")

    def toggle(self, name, installed):
        downloading = set((job_progress() or {}).get("names", []))
        if name in self.pending:
            del self.pending[name]
        elif name in downloading:
            self.pending[name] = "stop"
        else:
            self.pending[name] = "remove" if installed else "add"
        self.confirm = False

    def apply(self):
        pick = lambda action: [n for n, a in self.pending.items() if a == action]
        removes, adds, stops = pick("remove"), pick("add"), pick("stop")
        messages = []
        for name in removes:
            remove_language(name)
            messages.append(T["removed"].format(name))
        if adds or stops:
            # Languages share the English download, so a change restarts it with the new set.
            running = [n for n in (job_progress() or {}).get("names", []) if n not in stops]
            stop_job()
            if stops:
                messages.append(T["stopped"].format(", ".join(stops)))
            names = list(dict.fromkeys(running + adds))
            if names:
                start_job(names)
                messages.append(T["started"].format(", ".join(names)))
        self.pending.clear()
        self.message = " ".join(messages)

    def handle(self, key):
        items = self.items()
        item = items[min(self.cursor, len(items) - 1)]
        if key == "quit":
            return "quit"
        if isinstance(key, tuple):
            if key[1] in (64, 65):
                self.cursor = max(0, min(len(items) - 1, self.cursor + (1 if key[1] == 65 else -1)))
            return None
        if key == "esc":
            if self.filter:
                self.filter = ""
            elif self.pending and not self.confirm:
                self.message, self.confirm = T["pending"], True
            else:
                self.leave()
        elif key == "settings":
            self.leave()
        elif key == "up":
            self.cursor = max(0, self.cursor - 1)
        elif key == "down":
            self.cursor = min(len(items) - 1, self.cursor + 1)
        elif key in ("pgup", "pgdn"):
            step = max(1, self.popup.body() - 4)
            self.cursor = max(0, min(len(items) - 1, self.cursor + (step if key == "pgdn" else -step)))
        elif key in ("left", "right", " "):
            if item[0] == "setting":
                self.change(item[1], -1 if key == "left" else 1)
            else:
                self.toggle(item[1], item[2])
        elif key == "enter":
            if self.pending:
                self.apply()
        elif key == "backspace":
            self.filter = self.filter[:-1]
        elif key == "clear":
            self.filter = ""
        elif isinstance(key, str) and len(key) == 1:
            self.filter += key
            self.cursor = len(self.FIXED)
            self.top = 0
        return None


# ---------- launching ----------

def ask_word():
    """Ask for a word with whatever launcher the desktop has. None means: ask inside the terminal."""
    prompt = T["prompt"]
    candidates = [
        ["omarchy-menu-input", prompt, "--width", "400"],
        ["fuzzel", "--dmenu", "--lines", "0", "--prompt", prompt + ": "],
        ["wofi", "--dmenu", "--lines", "1", "--prompt", prompt],
        ["tofi", "--prompt-text", prompt + ": ", "--require-match=false"],
        ["rofi", "-dmenu", "-p", prompt],
        ["bemenu", "-p", prompt],
        ["zenity", "--entry", "--title", "lexi", "--text", prompt],
        ["kdialog", "--title", "lexi", "--inputbox", prompt],
        ["osascript", "-e", f'text returned of (display dialog "{prompt}" default answer "" with title "lexi")'],
    ]
    for cmd in candidates:
        if shutil.which(cmd[0]):
            r = subprocess.run(cmd, input="", capture_output=True, text=True)
            return r.stdout.strip()
    return None


def terminal_command(title, args):
    """A command that opens args in a terminal with lexi's app id and a slightly larger font."""
    size = FONT_SIZE
    terminals = [
        ("foot", ["foot", f"--app-id={APP_ID}", f"--title={title}", "-o", f"main.font={foot_font()}:size={size}",
                  "-o", "main.pad=0x16 center"]),
        ("kitty", ["kitty", "--class", APP_ID, "--title", title, "-o", f"font_size={size}",
                   "-o", "window_padding_width=12"]),
        ("alacritty", ["alacritty", "--class", APP_ID, "--title", title, "-o", f"font.size={size}",
                       "-o", "window.padding.y=12", "-e"]),
        ("ghostty", ["ghostty", f"--class={APP_ID}", f"--title={title}", f"--font-size={size}", "-e"]),
        ("wezterm", ["wezterm", "start", "--class", APP_ID, "--"]),
        ("xdg-terminal-exec", ["xdg-terminal-exec", f"--app-id={APP_ID}", f"--title={title}"]),
        ("gnome-terminal", ["gnome-terminal", f"--title={title}", "--"]),
        ("konsole", ["konsole", "-e"]),
        ("xterm", ["xterm", "-class", APP_ID, "-T", title, "-e"]),
    ]
    preferred = os.environ.get("LEXI_TERMINAL") or CFG.get("terminal")
    if preferred:
        terminals.sort(key=lambda t: t[0] != preferred)
    for name, cmd in terminals:
        if shutil.which(name):
            return cmd + args
    if sys.platform == "darwin":
        script = " ".join(shlex.quote(a) for a in args) + "; exit"
        return ["osascript", "-e", f"tell application \"Terminal\" to do script {json.dumps(script, ensure_ascii=False)}",
                "-e", "tell application \"Terminal\" to activate"]
    return None


def foot_font():
    try:
        with open(os.path.expanduser("~/.config/foot/foot.ini")) as f:
            m = re.search(r"^font\s*=\s*([^:,\n]+)", f.read(), re.M)
            if m:
                return m.group(1).strip()
    except OSError:
        pass
    return "monospace"


def launch(word=None, settings=False):
    if not word and not settings:
        word = ask_word()
        if word == "":
            return  # the user cancelled
    if settings:
        presize(30)
    else:
        presize(len(render(word, TEXT_WIDTH)[0]) if word else 6)
    me = os.path.abspath(__file__)
    args = ["--settings"] if settings else ([word] if word else [])
    cmd = terminal_command(f"lexi: {word or ''}".strip(), [sys.executable, me, "--view", *args])
    if not cmd:
        sys.exit("lexi: no terminal emulator found (set LEXI_TERMINAL)")
    if shutil.which("uwsm-app"):
        cmd = ["uwsm-app", "--", *cmd]
    subprocess.Popen(["setsid", *cmd] if shutil.which("setsid") else cmd,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


