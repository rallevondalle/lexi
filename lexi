}
T = STRINGS.get(CFG["lang"], STRINGS["en"])

RESET, BOLD, DIM, ITALIC = "\033[0m", "\033[1m", "\033[2m", "\033[3m"
ACCENT, LABEL, TAG = "\033[1;34m", "\033[1;35m", "\033[33m"


# ---------- rendering ----------

def style(text, *codes):
    return "".join(codes) + text + RESET if codes else text


def wrap(text, width, indent, hang, *codes, lead=None):
    """Wrap text to width; lead (already styled) replaces the first line's hanging indent."""
    text = re.sub(r"&?#(\d+);", lambda m: chr(int(m.group(1))), text)
    lines = textwrap.wrap(text, width - indent - hang) or [""]
    out = []
    for i, line in enumerate(lines):
        prefix = lead if (i == 0 and lead is not None) else " " * hang
        if i == 0:
            # Highlight a leading "(label)" the way Wiktionary uses them.
            m = re.match(r"^(\([^)]*\))(\s.*)?$", line)
            if m:
                out.append(" " * indent + prefix + style(m.group(1), TAG, ITALIC) + style(m.group(2) or "", *codes))
                continue
        out.append(" " * indent + prefix + style(line, *codes))
    return out


def fetch(db, key):
    return db.execute(
        "SELECT word, source, pos, ipa, etym, senses FROM entries WHERE key = ? ORDER BY source, rowid", (key,)
    ).fetchall()


def suggestions(db, key, n=5):
    if len(key) < 2:
        return []
    lo = key[:2]
    hi = lo[:-1] + chr(ord(lo[-1]) + 1)
    cands = [
        r[0]
        for r in db.execute(
            "SELECT key FROM words WHERE key >= ? AND key < ? AND length(key) BETWEEN ? AND ?",
            (lo, hi, len(key) - 2, len(key) + 2),
        )
    ]
    return difflib.get_close_matches(key, cands, n=n, cutoff=0.75)


# Glosses like "Alternative spelling of X" or "simple past of X" point at the word worth showing.
REF = re.compile(
    r"^(?:\([^)]*\)\s*)?[^.;:()]{0,60}?\b(?:spelling|form|misspelling|participle|tense|past|plural|"
    r"singular|gerund|comparative|superlative|abbreviation|initialism|acronym|contraction|clipping|"
    r"ellipsis|variant|indicative|subjunctive|person|synonym) of (?P<target>[^.;:()“”]+?)\s*"
    r"(?:\([^)]*\)|“[^”]*”)?\s*[.:]?$",
    re.I,
)


def references(db, entries, seen):
    """Words that entries refer to, with the parts of speech the references appear under."""
    found = {}
    for _, _, pos, _, _, senses in entries:
        for _, gloss, _ in json.loads(senses):
            m = REF.match(gloss.strip())
            if not m:
                continue
            target = m.group("target").strip().strip("'\"").lower()
            if target in seen or len(target) > 40:
                continue
            if db.execute("SELECT 1 FROM entries WHERE key = ? AND source = 0 LIMIT 1", (target,)).fetchone():
                found.setdefault(target, set()).add(pos)
    return list(found.items())[:3]


def collect(word):
    """Look word up and return the result as plain data (also what `lexi --json` prints).

    {"query", "found", "suggestions", "headword", "ipa",
     "sections": [{"title", "kind": "main"|"reference"|"wordnet", "ipa",
                   "entries": [{"word", "pos", "senses": [{"depth", "gloss", "example"}]}]}],
     "origins": [...]}
    """
    query = word.strip()
    result = {"query": query, "found": False, "suggestions": [], "headword": None, "ipa": None,
              "sections": [], "origins": []}
    if not os.path.exists(DB):
        result["error"] = "no_db"
        return result
    db = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    key = query.lower()
    rows = fetch(db, key)
    if not rows:
        result["suggestions"] = suggestions(db, key)
        if not result["suggestions"]:
            return result
        key = query = result["suggestions"][0]
        rows = fetch(db, key)
    result["found"] = True

    # The exact spelling (e.g. "free" before "Free") comes first.
    rows.sort(key=lambda r: (r[1], r[0] != query))
    result["headword"] = rows[0][0]
    result["ipa"] = next((r[3] for r in rows if r[3]), None)

    # Follow references such as "Alternative spelling of X" and merge X in below.
    sections = [("Wiktionary", "main", [r for r in rows if r[1] == WIKT])]
    seen = {key}
    queue = sections[0][2]
    while queue and len(sections) < 4:
        refs = references(db, queue, seen)
        queue = []
        for target, poses in refs:
            seen.add(target)
            trows = [r for r in fetch(db, target) if r[1] == WIKT]
            chosen = [r for r in trows if r[2] in poses] or trows
            if chosen:
                sections.append((target, "reference", chosen))
                queue += chosen
    wordnet = [r for r in rows if r[1] == WORDNET]
    if not wordnet:
        for target, _, _ in sections[1:]:
            wordnet = [r for r in fetch(db, target) if r[1] == WORDNET]
            if wordnet:
                break
    if wordnet:
        sections.append(("WordNet", "wordnet", wordnet))

    origins = []
    for title, kind, entries in sections:
        if not entries:
            continue
        result["sections"].append({
            "title": title,
            "kind": kind,
            "ipa": next((r[3] for r in entries if r[3]), None) if kind == "reference" else None,
            "entries": [
                {"word": w, "pos": pos, "senses": [
                    {"depth": d, "gloss": unescape(g), "example": unescape(x) if x else None}
                    for d, g, x in json.loads(senses)
                ]}
                for w, _, pos, _, _, senses in entries
            ],
        })
        origins += [r[4] for r in entries if r[4]]
    result["origins"] = list(dict.fromkeys(origins))[:3]
    return result


def unescape(text):
    return re.sub(r"&?#(\d+);", lambda m: chr(int(m.group(1))), text)


def render(word, width=TEXT_WIDTH):
    """Return (lines, found) for word, styled for the terminal at the given text width."""
    data = collect(word)
    if data.get("error") == "no_db":
        return [style(T["no_db"], BOLD), "", T["run_update"]], False
    out = []
    if not data["found"]:
        return [style(data["query"], ACCENT), "", style(T["nothing"], DIM)], False
    if data["suggestions"]:
        out += [style(data["query"], ACCENT) + style("  " + T["not_found"], DIM),
                style(T["did_you_mean"], DIM) + style(", ".join(data["suggestions"]), BOLD), ""]

    headword = data["headword"]
    out.append(style(headword, ACCENT) + ("   " + style(data["ipa"], DIM) if data["ipa"] else ""))
    sections = data["sections"]
    for i, sec in enumerate(sections):
        if len(sections) > 1:
            ref = sec["kind"] == "reference"
            head = f" {sec['title']} "
            line = style("── ", DIM) + style(sec["title"], ACCENT if ref else DIM) + " "
            if sec["ipa"]:
                line += style(sec["ipa"], DIM) + " "
                head += sec["ipa"] + " "
            out += ["", line + style("─" * max(2, width - len(head) - 3), DIM)]
        base = headword if i == 0 else sec["entries"][0]["word"]
        for entry in sec["entries"]:
            label = (entry["pos"] or "").upper()
            if entry["word"].lower() == base.lower() and entry["word"] != base:
                label += "  " + entry["word"]
            out += ["", style(label, LABEL)]
            num = sub = 0
            for sense in entry["senses"]:
                if sense["depth"] == 0:
                    num += 1
                    sub = 0
                    out += wrap(sense["gloss"], width, 0, 4, lead=style(f"{num:>2}", BOLD) + "  ")
                    hang = 4
                else:
                    sub += 1
                    letter = chr(ord("a") + (sub - 1) % 26)
                    out += wrap(sense["gloss"], width, 4, 3, lead=style(letter, DIM) + "  ")
                    hang = 7
                if sense["example"]:
                    out += wrap(f"“{sense['example']}”", width, hang, 0, DIM, ITALIC)

    if data["origins"]:
        out += ["", style(T["origin"], LABEL)]
        for i, etym in enumerate(data["origins"]):
            out += ([""] if i else []) + wrap(etym, width, 0, 0, DIM)
    return out, True


def complete(prefix, limit=30):
    """Words starting with prefix, shortest first (for launchers such as Raycast)."""
    prefix = prefix.strip().lower()
    if not prefix or not os.path.exists(DB):
        return []
    db = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    hi = prefix[:-1] + chr(ord(prefix[-1]) + 1)
    # Common words (in WordNet) and lowercase words before names and rare forms; then shortest first.
    words = [r[0] for r in db.execute(
        """SELECT key FROM (SELECT key FROM words WHERE key >= ? AND key < ? LIMIT 5000) AS w
           ORDER BY NOT EXISTS (SELECT 1 FROM entries e WHERE e.key = w.key AND e.source = 1),
                    NOT EXISTS (SELECT 1 FROM entries e WHERE e.key = w.key AND e.word = w.key),
                    length(key), key
           LIMIT ?""",
        (prefix, hi, limit))]
    return words or suggestions(db, prefix, n=10)


# ---------- popup window ----------

def on_hyprland():
    return bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")) and shutil.which("hyprctl")


def hyprctl(*args):
    try:
        return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout
    except OSError:
        return ""


def hypr_client():
    try:
        clients = json.loads(hyprctl("clients", "-j"))
    except json.JSONDecodeError:
        return None
    ours = [c for c in clients if c.get("class") == APP_ID]
    for c in ours:
        if c.get("pid") == os.getppid():
            return c
    return ours[-1] if ours else None


def hypr_dispatch(lua, legacy):
    """Lua-configured Hyprland takes Lua dispatchers; older versions take the classic syntax."""
    r = hyprctl("dispatch", lua)
    if "error" in r.lower() or "invalid" in r.lower():
        hyprctl("dispatch", *legacy.split(" ", 1))


def max_rows(cell_h):
    try:
        mon = next(m for m in json.loads(hyprctl("monitors", "-j")) if m.get("focused"))
        logical_h = mon["height"] / mon["scale"]
    except (StopIteration, json.JSONDecodeError, KeyError):
        logical_h = 800
    return max(8, int(logical_h * 0.85 / cell_h))


def target_grid(nlines, cell_h=24):
    cols = TEXT_WIDTH + 2 * MARGIN
    rows = min(nlines + 3, max_rows(cell_h))  # a blank row above and below, plus the status line
    return cols, max(rows, 8)


def read_fit():
    try:
        with open(FIT_FILE) as f:
            return tuple(map(float, f.read().split()))
    except (OSError, ValueError):
        return None


def write_fit(cw, ch, base_w, base_h):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(FIT_FILE, "w") as f:
        f.write(f"{cw:.3f} {ch:.3f} {base_w:.1f} {base_h:.1f}\n")


def presize(nlines):
    """Install a window rule before the terminal starts so the window maps floating, centered and sized."""
    if not on_hyprland():
        return
    props = "float = true, center = true, opacity = \"1 1\""
    fit = read_fit()
    if fit and len(fit) == 4:
        cw, ch, base_w, base_h = fit
        cols, rows = target_grid(nlines, ch)
        props += f", size = {{ {round(base_w + cols * cw)}, {round(base_h + (rows + 0.5) * ch)} }}"
    else:
        props += ", size = { 820, 560 }"
    hyprctl("eval", "if lexi_rule then lexi_rule:set_enabled(false) end; "
            f'lexi_rule = hl.window_rule({{ match = {{ class = "{APP_ID}" }}, {props} }})')


def settle():
    prev, held = None, 0
    for _ in range(20):
        cur = shutil.get_terminal_size()
        held = held + 1 if cur == prev else 0
        if held == 2:
            return
        prev = cur
        time.sleep(0.05)


def fit_window(nlines):
    """Resize the popup to its content and remember the cell size for next time."""
    if not on_hyprland():
        return
    settle()
    c = hypr_client()
    if c and not c.get("floating"):
        # Hyprland without the Lua rule API: float it by hand.
        hypr_dispatch(f'hl.dsp.window.float({{ action = "enable", window = "address:{c["address"]}" }})',
                      f"setfloating address:{c['address']}")
        settle()
    for _ in range(3):
        c = hypr_client()
        if not c:
            return
        cols, rows = shutil.get_terminal_size()
        w, h = c["size"]
        fit = read_fit()
        cw, ch = (fit[0], fit[1]) if fit and len(fit) == 4 else (w / cols, h / rows)
        tcols, trows = target_grid(nlines, ch)
        if abs(cols - tcols) <= 1 and rows == trows:
            write_fit(cw, ch, w - cols * cw, h - rows * ch)
            return
        nw, nh = round(w + (tcols - cols) * cw), round(h + (trows - rows) * ch)
        addr = c["address"]
        hypr_dispatch(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {nw}, y = {nh} }})',
                      f"resizewindowpixel exact {nw} {nh},address:{addr}")
        hypr_dispatch(f'hl.dsp.window.center({{ window = "address:{addr}" }})', "centerwindow")
        settle()
        # Measure the cell size from the change, which cancels out the terminal padding.
        ncols, nrows = shutil.get_terminal_size()
        if ncols != cols and nrows != rows:
            cw, ch = (nw - w) / (ncols - cols), (nh - h) / (nrows - rows)
            write_fit(cw, ch, nw - ncols * cw, nh - nrows * ch)


def view(word):
    if not word:
        try:
            word = input(f"\n  {T['prompt']}: ").strip()
        except (EOFError, KeyboardInterrupt):
            return
        if not word:
            return
    lines, _ = render(word)
    fit_window(len(lines))
    cols, _ = shutil.get_terminal_size()
    pad = " " * max(0, (cols - TEXT_WIDTH) // 2)
    text = "\n" + "\n".join(pad + l for l in lines) + "\n"
    if not shutil.which("less"):
        print(text)
        input()
        return
    prompt = pad + f"?e:{T['more']}  ·  .{T['close']}  ·  {T['search']}"
    opts = ["-R", "-c", "-~", "-K", "-Ps" + prompt]
    # macOS ships an old less, so only use options the installed version knows.
    version = less_version()
    if version >= 551:
        opts += ["--mouse", "--wheel-lines=3"]
    if version >= 600:
        opts += ["--use-color", "--color=PK"]
    if version >= 643:
        opts.append("--lesskey-content=#command\n\\e quit\n")
    subprocess.run(
        ["less", *opts],
        input=text, text=True,
    )


def less_version():
    try:
        out = subprocess.run(["less", "--version"], capture_output=True, text=True).stdout
        return int(re.search(r"less (\d+)", out).group(1))
    except (OSError, AttributeError, ValueError):
        return 0


def ask_word():
    """Ask for a word with whatever launcher the desktop has. None means: ask inside the terminal."""
    prompt = T["prompt"]
    candidates = [
        ["omarchy-menu-input", prompt, "--width", "400"],
        ["fuzzel", "--dmenu", "--lines", "0", "--prompt", prompt + ": "],
        ["wofi", "--dmenu", "--lines", "1", "--prompt", prompt],
        ["tofi", "--prompt-text", prompt + ": ", "--require-match=false"],
        ["rofi", "-dmenu", "-p", prompt],
        ["bemenu", "-p", prompt],
        ["zenity", "--entry", "--title", "lexi", "--text", prompt],
        ["kdialog", "--title", "lexi", "--inputbox", prompt],
        ["osascript", "-e", f'text returned of (display dialog "{prompt}" default answer "" with title "lexi")'],
    ]
    for cmd in candidates:
        if shutil.which(cmd[0]):
            r = subprocess.run(cmd, input="", capture_output=True, text=True)
            return r.stdout.strip()
    return None


def terminal_command(title, args):
    """A command that opens args in a terminal with lexi's app id and a slightly larger font."""
    size = FONT_SIZE
    terminals = [
        ("foot", ["foot", f"--app-id={APP_ID}", f"--title={title}", "-o", f"main.font={foot_font()}:size={size}",
                  "-o", "main.pad=0x16 center"]),
        ("kitty", ["kitty", "--class", APP_ID, "--title", title, "-o", f"font_size={size}",
                   "-o", "window_padding_width=12"]),
        ("alacritty", ["alacritty", "--class", APP_ID, "--title", title, "-o", f"font.size={size}",
                       "-o", "window.padding.y=12", "-e"]),
        ("ghostty", ["ghostty", f"--class={APP_ID}", f"--title={title}", f"--font-size={size}", "-e"]),
        ("wezterm", ["wezterm", "start", "--class", APP_ID, "--"]),
        ("xdg-terminal-exec", ["xdg-terminal-exec", f"--app-id={APP_ID}", f"--title={title}"]),
        ("gnome-terminal", ["gnome-terminal", f"--title={title}", "--"]),
        ("konsole", ["konsole", "-e"]),
        ("xterm", ["xterm", "-class", APP_ID, "-T", title, "-e"]),
    ]
    preferred = os.environ.get("LEXI_TERMINAL") or CFG.get("terminal")
    if preferred:
        terminals.sort(key=lambda t: t[0] != preferred)
    for name, cmd in terminals:
        if shutil.which(name):
            return cmd + args
    if sys.platform == "darwin":
        script = " ".join(shlex.quote(a) for a in args) + "; exit"
        return ["osascript", "-e", f"tell application \"Terminal\" to do script {json.dumps(script, ensure_ascii=False)}",
                "-e", "tell application \"Terminal\" to activate"]
    return None


def foot_font():
    try:
        with open(os.path.expanduser("~/.config/foot/foot.ini")) as f:
            m = re.search(r"^font\s*=\s*([^:,\n]+)", f.read(), re.M)
            if m:
                return m.group(1).strip()
    except OSError:
        pass
    return "monospace"


def launch(word=None):
    if not word:
        word = ask_word()
        if word == "":
            return  # the user cancelled
    lines, _ = render(word) if word else ([], False)
    presize(len(lines) if word else 6)
    me = os.path.abspath(__file__)
    cmd = terminal_command(f"lexi: {word or ''}".strip(), [sys.executable, me, "--view", *([word] if word else [])])
    if not cmd:
        sys.exit("lexi: no terminal emulator found (set LEXI_TERMINAL)")
    if shutil.which("uwsm-app"):
        cmd = ["uwsm-app", "--", *cmd]
    subprocess.Popen(["setsid", *cmd] if shutil.which("setsid") else cmd,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---------- building the database ----------

def download(url, label):
    """Stream url, reporting progress on stderr."""
    req = urllib.request.Request(url, headers={"User-Agent": f"lexi/{VERSION}"})
    resp = urllib.request.urlopen(req, timeout=60)
    total = int(resp.headers.get("Content-Length") or 0)

    class Progress:
        def __init__(self):
            self.done, self.shown = 0, -1

        def read(self, n=-1):
            chunk = resp.read(n)
            self.done += len(chunk)
            if total:
                pct = self.done * 100 // total
                if pct != self.shown:
                    self.shown = pct
                    print(f"\r  {label}: {pct:3d}% of {total / 1e6:.0f} MB", end="", file=sys.stderr, flush=True)
            return chunk

    return Progress()


def clean_etymology(text):
    if not text:
        return None
    lines = [l.strip() for l in text.split("\n") if l.strip()]
    if lines and lines[0] == "Etymology tree":
        # The tree lists ancestor forms and ends with "English <word>".
        end = next((i for i, l in enumerate(lines) if l.startswith("English ")), 0)
        lines = lines[end + 1:]
    # The first paragraph is the derivation itself; the rest is usually cognates.
    return lines[0][:500] if lines else None


def wiktionary_rows(stream):
    for line in gzip.open(stream, "rt", encoding="utf-8"):
        e = json.loads(line)
        if e.get("lang_code") != "en" or not e.get("word"):
            continue
        senses, last_parent = [], None
        for s in e.get("senses", []):
            if "no-gloss" in (s.get("tags") or []):
                continue
            glosses = s.get("raw_glosses") or s.get("glosses")
            if not glosses:
                continue
            if len(glosses) > 1 and glosses[0] != last_parent:
                senses.append([0, glosses[0], None])
            last_parent = glosses[0]
            example = next(
                (x["text"] for x in s.get("examples", []) if x.get("text") and len(x["text"]) <= 220), None
            )
            senses.append([min(len(glosses) - 1, 1), glosses[-1], example])
        if not senses:
            continue
        ipa = []
        for snd in e.get("sounds", []):
            if snd.get("ipa") and snd["ipa"] not in ipa:
                ipa.append(snd["ipa"])
            if len(ipa) == 2:
                break
        yield (e["word"].lower(), e["word"], WIKT, e.get("pos"), " ".join(ipa) or None,
               clean_etymology(e.get("etymology_text")), json.dumps(senses, ensure_ascii=False))


WN_POS = {"n": "noun", "v": "verb", "a": "adj", "s": "adj", "r": "adv"}


def wordnet_rows(stream):
    synsets, entries = {}, []
    for _, el in ET.iterparse(gzip.open(stream)):
        if el.tag == "LexicalEntry":
            lemma = el.find("Lemma")
            entries.append((lemma.get("writtenForm"), lemma.get("partOfSpeech"),
                            [s.get("synset") for s in el.findall("Sense")]))
            el.clear()
        elif el.tag == "Synset":
            d = el.find("Definition")
            synsets[el.get("id")] = {
                "def": d.text if d is not None else None,
                "ex": [x.text for x in el.findall("Example") if x.text][:1],
                "lemmas": [],
            }
            el.clear()
    for word, _, ids in entries:
        for sid in ids:
            if sid in synsets:
                synsets[sid]["lemmas"].append(word)
    for word, pos, ids in entries:
        senses = []
        for sid in ids:
            s = synsets.get(sid)
            if not s or not s["def"]:
                continue
            syn = [l for l in s["lemmas"] if l != word][:6]
            gloss = s["def"] + (f"  [syn: {', '.join(syn)}]" if syn else "")
            senses.append([0, gloss, s["ex"][0] if s["ex"] else None])
        if senses:
            yield (word.lower(), word, WORDNET, WN_POS.get(pos, pos), None, None,
                   json.dumps(senses, ensure_ascii=False))


def wordnet_url():
    try:
        with urllib.request.urlopen(WORDNET_RELEASES, timeout=20) as r:
            assets = json.load(r).get("assets", [])
        for a in assets:
            if re.fullmatch(r"english-wordnet-\d{4}\.xml\.gz", a["name"]):
                return a["browser_download_url"]
    except (OSError, ValueError, KeyError):
        pass
    return WORDNET_FALLBACK


def update():
    os.makedirs(DATA_DIR, exist_ok=True)
    tmp = DB + ".new"
    if os.path.exists(tmp):
        os.remove(tmp)
    db = sqlite3.connect(tmp)
    db.executescript("""
        PRAGMA journal_mode = OFF;
        PRAGMA synchronous = OFF;
        CREATE TABLE entries (key TEXT, word TEXT, source INT, pos TEXT, ipa TEXT, etym TEXT, senses TEXT);
    """)
    print("Building the lexi dictionary. This downloads about 540 MB and takes a few minutes.", file=sys.stderr)
    sources = (("Open English WordNet", wordnet_url(), wordnet_rows),
               ("Wiktionary", WIKTIONARY_URL, wiktionary_rows))
    for label, url, rows in sources:
        n, batch = 0, []
        for row in rows(download(url, label)):
            batch.append(row)
            n += 1
            if len(batch) == 20000:
                db.executemany("INSERT INTO entries VALUES (?,?,?,?,?,?,?)", batch)
                batch.clear()
        db.executemany("INSERT INTO entries VALUES (?,?,?,?,?,?,?)", batch)
        print(f"\r  {label}: {n:,} entries" + " " * 20, file=sys.stderr)
    print("  Indexing…", file=sys.stderr)
    db.executescript("""
        CREATE INDEX entries_key ON entries (key);
        CREATE TABLE words AS SELECT DISTINCT key FROM entries;
        CREATE INDEX words_key ON words (key);
        VACUUM;
    """)
    db.close()
    os.replace(tmp, DB)
    print(f"Done: {DB} ({os.path.getsize(DB) / 1e6:.0f} MB)", file=sys.stderr)


# ---------- main ----------

def main():
    args = sys.argv[1:]
    if not args:
        launch()
    elif args[0] in ("-h", "--help"):
        print(__doc__.strip())
    elif args[0] in ("-V", "--version"):
        print(f"lexi {VERSION}")
    elif args[0] == "update":
        try:
            update()
        except KeyboardInterrupt:
            sys.exit("\nlexi: update cancelled")
    elif args[0] == "--json":
        print(json.dumps(collect(" ".join(args[1:])), ensure_ascii=False))
    elif args[0] == "--complete":
        print(json.dumps(complete(" ".join(args[1:])), ensure_ascii=False))
    elif args[0] == "--open":
        launch(" ".join(args[1:]) or None)
    elif args[0] == "--view":
        view(" ".join(args[1:]))
    else:
        width = min(TEXT_WIDTH, shutil.get_terminal_size().columns - 2)
        lines, found = render(" ".join(args), width)
        if not sys.stdout.isatty():
            lines = [re.sub(r"\033\[[0-9;]*m", "", l) for l in lines]
        print("\n".join(lines))
        sys.exit(0 if found else 1)


if __name__ == "__main__":
    main()
