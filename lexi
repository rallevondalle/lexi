import gzip
import json
import math
import os
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys
import textwrap
import time
import urllib.request
import xml.etree.ElementTree as ET

VERSION = "1.0.0"
APP_ID = "lexi.popup"


def xdg(var, fallback):
    return os.path.join(os.environ.get(var) or os.path.expanduser(fallback), "lexi")


DATA_DIR = xdg("XDG_DATA_HOME", "~/.local/share")
STATE_DIR = xdg("XDG_STATE_HOME", "~/.local/state")
CONFIG_FILE = os.path.join(xdg("XDG_CONFIG_HOME", "~/.config"), "config")
DB = os.environ.get("LEXI_DB", os.path.join(DATA_DIR, "lexi.db"))
FIT_FILE = os.path.join(STATE_DIR, "cell")

WIKTIONARY_URL = "https://kaikki.org/dictionary/English/kaikki.org-dictionary-English.jsonl.gz"
WORDNET_RELEASES = "https://api.github.com/repos/globalwordnet/english-wordnet/releases/latest"
WORDNET_FALLBACK = ("https://github.com/globalwordnet/english-wordnet/releases/download/"
                    "2025-edition/english-wordnet-2025.xml.gz")

WIKT, WORDNET = 0, 1


# ---------- configuration ----------

def load_config():
    """~/.config/lexi/config holds key = value lines; LEXI_* environment variables win."""
    cfg = {"lang": "en", "font_size": "12", "width": "76"}
    try:
        with open(CONFIG_FILE) as f:
            for line in f:
                line = line.split("#", 1)[0]
                if "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip().strip('"')
    except OSError:
        pass
    for k in list(cfg):
        cfg[k] = os.environ.get("LEXI_" + k.upper(), cfg[k])
    return cfg


CFG = load_config()
TEXT_WIDTH = max(40, int(CFG["width"]))
FONT_SIZE = CFG["font_size"]
MARGIN = 4  # empty columns on each side of the text in the popup

STRINGS = {
    "en": {
        "prompt": "Look up a word",
        "not_found": "not found",
        "nothing": "No definition found.",
        "did_you_mean": "Did you mean: ",
        "origin": "ORIGIN",
        "more": "↓ more",
        "close": "q close",
        "search": "/ search",
        "no_db": "The dictionary hasn't been built yet.",
        "run_update": "Run: lexi update",
    },
    "da": {
        "prompt": "Slå engelsk ord op",
        "not_found": "ikke fundet",
        "nothing": "Ingen forklaring fundet.",
        "did_you_mean": "Mente du: ",
        "origin": "OPRINDELSE",
        "more": "↓ mere",
        "close": "q luk",
        "search": "/ søg",
        "no_db": "Ordbogen er ikke bygget endnu.",
        "run_update": "Kør: lexi update",
