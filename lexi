def capitalize(text):
    return text[:1].upper() + text[1:]


RESET, BOLD, DIM, ITALIC, REVERSE = "\033[0m", "\033[1m", "\033[2m", "\033[3m", "\033[7m"
ACCENT, LABEL, TAG = "\033[1;34m", "\033[1;35m", "\033[33m"


# ---------- rendering ----------

def style(text, *codes):
    return "".join(codes) + text + RESET if codes else text


def wrap(text, width, indent, hang, *codes, lead=None):
    """Wrap text to width; lead (already styled) replaces the first line's hanging indent."""
    text = re.sub(r"&?#(\d+);", lambda m: chr(int(m.group(1))), text)
    lines = textwrap.wrap(text, width - indent - hang) or [""]
    out = []
    for i, line in enumerate(lines):
        prefix = lead if (i == 0 and lead is not None) else " " * hang
        if i == 0:
            # Highlight a leading "(label)" the way Wiktionary uses them.
            m = re.match(r"^(\([^)]*\))(\s.*)?$", line)
            if m:
                out.append(" " * indent + prefix + style(m.group(1), TAG, ITALIC) + style(m.group(2) or "", *codes))
                continue
        out.append(" " * indent + prefix + style(line, *codes))
    return out


def fold(text):
    """Lowercase without accents, so "kutta" matches the romanization "kuttā"."""
    return "".join(c for c in unicodedata.normalize("NFKD", text.lower()) if not unicodedata.combining(c))


def aliases(db, key):
    """Words written in another script whose romanization is key, e.g. कुत्ता for "kutta"."""
    try:
        return [r[0] for r in db.execute("SELECT DISTINCT target FROM aliases WHERE key IN (?, ?) LIMIT 5",
                                         (key, fold(key)))]
    except sqlite3.OperationalError:
        return []  # languages downloaded before romanizations were kept


def connect(path):
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True)


def installed_languages():
    """[{"code", "name", "path"}] for every downloaded language, by name."""
    langs = []
    for path in glob.glob(os.path.join(LANG_DIR, "*.db")):
        try:
            meta = dict(connect(path).execute("SELECT key, value FROM meta"))
            langs.append({"code": meta["code"], "name": meta["name"], "path": path})
        except (sqlite3.Error, KeyError):
            continue
    return sorted(langs, key=lambda l: l["name"])


def fetch(db, key):
    try:
        return db.execute("SELECT word, source, pos, ipa, etym, senses, forms FROM entries "
                          "WHERE key = ? ORDER BY source, rowid", (key,)).fetchall()
    except sqlite3.OperationalError:
        # Databases built by lexi 1.0 have no forms column.
        return db.execute("SELECT word, source, pos, ipa, etym, senses, NULL FROM entries "
                          "WHERE key = ? ORDER BY source, rowid", (key,)).fetchall()


def suggestions(db, key, n=5):
    if len(key) < 2:
        return []
    lo = key[:2]
    hi = lo[:-1] + chr(ord(lo[-1]) + 1)
    cands = [
        r[0]
        for r in db.execute(
            "SELECT key FROM words WHERE key >= ? AND key < ? AND length(key) BETWEEN ? AND ?",
            (lo, hi, len(key) - 2, len(key) + 2),
        )
    ]
    return difflib.get_close_matches(key, cands, n=n, cutoff=0.75)


# Glosses like "Alternative spelling of X" or "simple past of X" point at the word worth showing.
REF = re.compile(
    r"^(?:\([^)]*\)\s*)?[^.;:()]{0,60}?\b(?:spelling|form|misspelling|participle|tense|past|plural|"
    r"singular|gerund|comparative|superlative|abbreviation|initialism|acronym|contraction|clipping|"
    r"ellipsis|variant|indicative|subjunctive|person|synonym) of (?P<target>[^.;:()“”]+?)\s*"
    r"(?:\([^)]*\)|“[^”]*”)?\s*(?:\.|:.*)?$",
    re.I,
)


def references(db, entries, seen, source=WIKT):
    """Words that entries refer to, with the parts of speech the references appear under."""
    found = {}
    for _, _, pos, _, _, senses, _ in entries:
        for _, gloss, _ in json.loads(senses):
            m = REF.match(gloss.strip())
            if not m:
                continue
            target = m.group("target").strip().strip("'\"").lower()
            if target in seen or len(target) > 40:
                continue
            if db.execute("SELECT 1 FROM entries WHERE key = ? AND source = ? LIMIT 1", (target, source)).fetchone():
                found.setdefault(target, set()).add(pos)
    return list(found.items())[:3]


def follow(db, first, seen, limit):
    """The section first plus the words its entries refer to, e.g. "Alternative spelling of X"."""
    source = first[2][0][1] if first[2] else WIKT
    out, queue = [first], first[2]
    while queue and len(out) < limit:
        refs = references(db, queue, seen, source)
        queue = []
        for target, poses in refs:
            seen.add(target)
            trows = [r for r in fetch(db, target) if r[1] == source]
            chosen = [r for r in trows if r[2] in poses] or trows
            if chosen:
                out.append((target, "reference", chosen))
                queue += chosen
    return out


def collect(word):
    """Look word up and return the result as plain data (also what `lexi --json` prints).

    {"query", "found", "suggestions", "headword", "ipa",
     "sections": [{"title", "kind": "main"|"reference"|"wordnet"|"translation"|"foreign", "ipa",
                   "entries": [{"word", "pos", "forms", "senses": [{"depth", "gloss", "example"}]}]}],
     "origins": [...]}
    """
    query = word.strip()
    result = {"query": query, "found": False, "suggestions": [], "headword": None, "ipa": None,
              "sections": [], "origins": [], "untranslated": []}
    if not os.path.exists(DB):
        result["error"] = "no_db"
        return result
    main = connect(DB)
    langs = [(l, connect(l["path"])) for l in installed_languages()]

    def lookup(key):
        # Databases from before languages had their own files may still hold Danish rows; skip them.
        return ([r for r in fetch(main, key) if r[1] in (WIKT, WORDNET)],
                [fetch(db, key) or [r for target in aliases(db, key) for r in fetch(db, target)]
                 for _, db in langs])

    key = query.lower()
    main_rows, lang_rows = lookup(key)
    if not main_rows and not any(lang_rows):
        cands = [s for db in [main] + [db for _, db in langs] for s in suggestions(db, key)]
        result["suggestions"] = difflib.get_close_matches(key, list(dict.fromkeys(cands)), n=5, cutoff=0.75)
        if not result["suggestions"]:
            return result
        key = query = result["suggestions"][0]
        main_rows, lang_rows = lookup(key)
    result["found"] = True

    # The exact spelling (e.g. "free" before "Free") comes first.
    everything = sorted(main_rows, key=lambda r: (r[1], r[0] != query)) + [r for rows in lang_rows for r in rows]
    result["headword"] = everything[0][0]
    # An English headword only takes an English pronunciation.
    result["ipa"] = next((r[3] for r in (main_rows or everything) if r[3]), None)

    seen = {key}
    english = follow(main, ("Wiktionary", "main", [r for r in sorted(main_rows, key=lambda r: r[0] != query)
                                                    if r[1] == WIKT]), seen, 4)
    wordnet = [r for r in main_rows if r[1] == WORDNET]
    for target, _, _ in english[1:]:
        wordnet = wordnet or [r for r in fetch(main, target) if r[1] == WORDNET]

    sections = []
    for (lang, db), rows in zip(langs, lang_rows):
        name = lang_label(lang["name"])
        title = capitalize(T["en_x"].format(name))
        translations = [r for r in rows if r[1] == EN_X]
        # "ran" has no translations of its own, so use those of "run".
        for target, _, _ in english[1:]:
            if translations:
                break
            translations = [r for r in fetch(db, target) if r[1] == EN_X]
            if translations:
                title += ": " + target
        if translations:
            sections.append((title, "translation", translations))
        elif main_rows and not any(r[1] in (FOREIGN, NATIVE, DANNET) for r in rows):
            result["untranslated"].append(name)
        # The language's own explanation: its Wiktionary's full definitions, else DanNet's shortened ones.
        native = [r for r in rows if r[1] == NATIVE] or [r for r in rows if r[1] == DANNET]
        if native:
            source = "Wiktionary" if native[0][1] == NATIVE else "DanNet"
            sections.append((capitalize(T["native"].format(name)) + " · " + source, "native", native))
        foreign = follow(db, (capitalize(T["x_en"].format(name)), "foreign", [r for r in rows if r[1] == FOREIGN]),
                         seen, 3)
        sections += foreign
        if not native:
            sections += explained(main, [r for _, _, entries in foreign for r in entries], seen)
    sections += english
    if wordnet and wordnet_on():
        sections.append(("WordNet", "wordnet", wordnet))

    origins, foreign_origins = [], []
    for title, kind, entries in sections:
        if not entries:
            continue
        ipa = next((r[3] for r in entries if r[3]), None)
        result["sections"].append({
            "title": title,
            "kind": kind,
            "ipa": ipa if kind == "reference" or (kind == "foreign" and ipa != result["ipa"]) else None,
            "entries": [
                {"word": w, "pos": pos, "forms": forms, "senses": [
                    {"depth": d, "gloss": unescape(g), "example": unescape(x) if x else None}
                    for d, g, x in json.loads(senses)
                ]}
                for w, _, pos, _, _, senses, forms in entries
            ],
        })
        if kind not in ("translation", "native", "explained"):
            (foreign_origins if entries and entries[0][1] == FOREIGN else origins).extend(r[4] for r in entries if r[4])
    # Other languages' etymologies only when there is no English one, so "and" doesn't mix the two.
    result["origins"] = list(dict.fromkeys(origins or foreign_origins))[:3]
    return result


def explained(main, entries, seen, limit=2):
    """English definitions of the words that foreign entries translate to, e.g. transitiv → transitive."""
    out = []
    for _, _, pos, _, _, senses, _ in entries:
        for _, gloss, _ in json.loads(senses):
            if REF.match(gloss.strip()):
                continue
            for part in re.split(r"[,;]", re.sub(r"\([^)]*\)", "", gloss)):
                part = part.strip().lower()
                if pos == "verb" and part.startswith("to "):
                    part = part[3:]
                if not part or len(part.split()) > 3 or part in seen:
                    continue
                rows = [r for r in fetch(main, part) if r[1] == WIKT and r[2] == pos]
                if rows:
                    seen.add(part)
                    # A short version: the first three top-level senses, without examples.
                    top = [[0, g, None] for d, g, _ in json.loads(rows[0][5]) if d == 0][:3]
                    row = rows[0][:4] + (None, json.dumps(top, ensure_ascii=False), None)
                    out.append((T["explained"].format(part), "explained", [row]))
                    if len(out) == limit:
                        return out
    return out


def unescape(text):
    return re.sub(r"&?#(\d+);", lambda m: chr(int(m.group(1))), text)


def render(word, width):
    """Return (lines, found) for word, styled for the terminal at the given text width."""
    data = collect(word)
    if data.get("error") == "no_db":
        return [style(T["no_db"], BOLD), "", T["run_update"]], False
    out = []
    if not data["found"]:
        return [style(data["query"], ACCENT), "", style(T["nothing"], DIM)], False
    if data["suggestions"]:
        out += [style(data["query"], ACCENT) + style("  " + T["not_found"], DIM),
                style(T["did_you_mean"], DIM) + style(", ".join(data["suggestions"]), BOLD), ""]

    headword = data["headword"]
    out.append(style(headword, ACCENT) + ("   " + style(data["ipa"], DIM) if data["ipa"] else ""))
    if data["untranslated"]:
        out += wrap(T["no_translation"].format(", ".join(data["untranslated"])), width, 0, 0, DIM)
    sections = data["sections"]
    for i, sec in enumerate(sections):
        if len(sections) > 1 or sec["kind"] in ("foreign", "translation", "native"):
            ref = sec["kind"] not in ("main", "wordnet")
            head = f" {sec['title']} "
            line = style("── ", DIM) + style(sec["title"], ACCENT if ref else DIM) + " "
            if sec["ipa"]:
                line += style(sec["ipa"], DIM) + " "
                head += sec["ipa"] + " "
            out += ["", line + style("─" * max(2, width - len(head) - 3), DIM)]
        base = headword if sec["kind"] != "reference" else sec["entries"][0]["word"]
        for entry in sec["entries"]:
            label = (entry["pos"] or "").upper()
            if entry["word"].lower() == base.lower() and entry["word"] != base:
                label += "  " + entry["word"]
            out.append("")
            if entry["forms"]:
                out += wrap(entry["forms"], width, 0, len(label) + 2, DIM, lead=style(label, LABEL) + "  ")
            else:
                out.append(style(label, LABEL))
            num = sub = 0
            for sense in entry["senses"]:
                if sense["depth"] == 0:
                    num += 1
                    sub = 0
                    out += wrap(sense["gloss"], width, 0, 4, lead=style(f"{num:>2}", BOLD) + "  ")
                    hang = 4
                else:
                    sub += 1
                    letter = chr(ord("a") + (sub - 1) % 26)
                    out += wrap(sense["gloss"], width, 4, 3, lead=style(letter, DIM) + "  ")
                    hang = 7
                if sense["example"]:
                    out += wrap(f"“{sense['example']}”", width, hang, 0, DIM, ITALIC)

    if data["origins"]:
        out += ["", style(T["origin"], LABEL)]
        for i, etym in enumerate(data["origins"]):
            out += ([""] if i else []) + wrap(etym, width, 0, 0, DIM)
    return out, True


def complete(prefix, limit=30):
    """Words starting with prefix, English first and shortest first (for launchers such as Raycast)."""
    prefix = prefix.strip().lower()
    if not prefix or not os.path.exists(DB):
        return []
    db = connect(DB)
    hi = prefix[:-1] + chr(ord(prefix[-1]) + 1)
    # Common words (in WordNet) and lowercase words before names and rare forms; then shortest first.
    words = [r[0] for r in db.execute(
        """SELECT key FROM (SELECT key FROM words WHERE key >= ? AND key < ? LIMIT 5000) AS w
           ORDER BY NOT EXISTS (SELECT 1 FROM entries e WHERE e.key = w.key AND e.source = 1),
                    NOT EXISTS (SELECT 1 FROM entries e WHERE e.key = w.key AND e.word = w.key),
                    length(key), key
           LIMIT ?""",
        (prefix, hi, limit))]
    # Interleave the other languages' words, so "hyg" offers "hygge" as well as "hygiene".
    lists = [words] + [[r[0] for r in connect(lang["path"]).execute(
        "SELECT key FROM words WHERE key >= ? AND key < ? ORDER BY length(key), key LIMIT ?", (prefix, hi, limit))]
        for lang in installed_languages()]
    words = list(dict.fromkeys(w for group in itertools.zip_longest(*lists) for w in group if w))[:limit]
    return words or suggestions(db, prefix, n=10)


